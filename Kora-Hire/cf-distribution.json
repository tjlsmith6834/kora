{
  "DistributionConfig": {
    "CallerReference": "hirekora-001",
    "Origins": {
      "Quantity": 1,
      "Items": [
        {
          "Id": "S3-www.my.hirekora.com",
          "DomainName": "www.my.hirekora.com.s3.amazonaws.com",
          "OriginAccessControlId": "E11WUR2E9DJED9",
          "S3OriginConfig": {
            "OriginAccessIdentity": ""
          }
        }
      ]
    },
    "DefaultCacheBehavior": {
      "TargetOriginId": "S3-www.my.hirekora.com",
      "ViewerProtocolPolicy": "redirect-to-https",
	  "MinTTL": 0,
	  "DefaultTTL": 86400,
	  "MaxTTL": 31536000,
      "AllowedMethods": {
        "Quantity": 2,
        "Items": ["GET", "HEAD"]
      },
      "ForwardedValues": {
        "QueryString": false,
        "Cookies": {
          "Forward": "none"
        }
      }
    },
    "Enabled": true,
    "Comment": "CloudFront for Hirekora React App",
    "ViewerCertificate": {
      "CloudFrontDefaultCertificate": true
    },
    "DefaultRootObject": "index.html",
    "CustomErrorResponses": {
      "Quantity": 1,
      "Items": [
        {
          "ErrorCode": 404,
          "ResponseCode": "200",
          "ResponsePagePath": "/index.html"
        }
      ]
    }
  }
}